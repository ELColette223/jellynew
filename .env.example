# Jellyfin server URL for production deployment.
# Set this to your Jellyfin server address to skip the manual server input screen.
# Example: JELLYFIN_SERVER_URL=https://jellyfin.example.com
JELLYFIN_SERVER_URL=

# ── Ticket System ──────────────────────────────────────────────────────────────

# Path where the SQLite database file will be stored
TICKET_DB_PATH=./data/tickets.db

# Port for the ticket backend API server
TICKET_SERVER_PORT=3001

# Origin of the Jellyfin Web frontend (used for CORS)
FRONTEND_ORIGIN=http://localhost:8080

# SMTP – email notifications (leave blank to disable emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_ADMIN_EMAIL=admin@example.com

# ── jellyfin-register integration ─────────────────────────────────────────────

# Base URL of the jellyfin-register PHP service (no trailing slash)
# Example: REGISTER_API_URL=http://localhost/jellyfin-register
REGISTER_API_URL=

# Shared secret – must match INTERNAL_API_SECRET in jellyfin-register's .env
REGISTER_API_SECRET=